{
  "manifest_version": 3,
  "name": "MAHO 拾图 · 绘画参考收集",
  "version": "3.1.0",
  "description": "参考 Image Picka 的个人素材收集器：随手收图、多页提取、精细筛选、来源记录与 ZIP 下载。",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MAHO 拾图",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https: http: data: blob:; style-src 'self'; connect-src 'self' https: http: data:; base-uri 'none'; form-action 'none'"
  },
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "打开 MAHO 拾图"
    }
  }
}
